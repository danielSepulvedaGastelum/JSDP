
/* The oval reveal echoes the photograph's organic frame in Sonora orgánica. */
:root {
  --route-duration: 420ms;
  --route-ease: cubic-bezier(.16, 1, .3, 1);
}
html[data-route-direction]::view-transition-group(root) { animation-duration: var(--route-duration); }
html[data-route-direction]::view-transition-old(root) {
  animation: route-leave 180ms ease-out both;
}
html[data-route-direction]::view-transition-new(root) {
  animation: route-open-login var(--route-duration) var(--route-ease) both;
}
html[data-route-direction="home"]::view-transition-new(root) {
  animation-name: route-open-home;
}
@keyframes route-open-login {
  from { clip-path: ellipse(0% 0% at 72% 50%); }
  to { clip-path: ellipse(150% 150% at 72% 50%); }
}
@keyframes route-open-home {
  from { clip-path: ellipse(0% 0% at 24% 36%); }
  to { clip-path: ellipse(150% 150% at 24% 36%); }
}
@keyframes route-leave { to { opacity: 0; } }
@keyframes route-crossfade { from { opacity: .35; } to { opacity: 1; } }
.route-scene-fallback { animation: route-crossfade 220ms ease-out; }
.route-scene main:focus { outline: none; }
.header-action-login { text-decoration: none; }
.header-action-login:hover { background: var(--green-dark); }
@media (prefers-reduced-motion: reduce) {
  html[data-route-direction]::view-transition-group(root) { animation-duration: 100ms; }
  html[data-route-direction]::view-transition-old(root) { animation: route-leave 100ms linear both; }
  html[data-route-direction]::view-transition-new(root) { animation: route-crossfade 100ms linear both; }
  .route-scene-fallback { animation-duration: 100ms; }
}
